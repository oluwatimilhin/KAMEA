# Replace with KAMEA's WhatsApp number including country code, digits only.
# Example format: +233 505698067
NEXT_PUBLIC_WHATSAPP_NUMBER=+233505698067

# Public Supabase project URL and publishable (or legacy anon) key.
# Never put the service_role / secret key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public KAMEA Instagram profile URL; leave unset until the account is confirmed.
NEXT_PUBLIC_INSTAGRAM_URL=

# HTTPS webhook that accepts POST JSON: { "email": "customer@example.com" }.
# Leave unset until KAMEA chooses a newsletter provider / endpoint.
NEWSLETTER_SUBSCRIPTION_URL=
# Optional bearer token for the newsletter endpoint (server-side only).
NEWSLETTER_SUBSCRIPTION_TOKEN=
